import java.util.*;

public class StringMethods {
    public static void main(String[] args) {
      String str="Satish";
      String str1="satish";
    
      //string length
      System.out.println(str+" length:"+str.length());
      //charAt-indexofchar
      System.out.println("charat:"+str.charAt(3));
      //toUpperCase
      System.out.println("captail case:"+str.toUpperCase());
      //tolowercase
      System.out.println("captail case:"+str.toLowerCase());
      //substring
      System.out.println("substring:"+str.substring(0,3));
      //indexof
      System.out.println("indexof:"+str.indexOf('i'));
      //==:address
      System.out.println("==:"+(str==str1));
      //equals-values
      System.out.println(str.equals(str1));
      //trim
      String str2="   vamshi   ";
      System.out.println(str2.length());
      System.out.println(str2.trim());
      //replace
      System.out.println(str.replace("Satish","mahesh"));
      //split
      String[] arr=str.split("");
      for(int i=0;i<arr.length;i++){
      System.out.println(arr[i]);
      }

    //contains
    System.out.println(str1.contains("sh"));
    //isempty
    System.out.println(str.isEmpty());
    

    }
}